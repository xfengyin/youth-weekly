<view class="container">
  <!-- 头部 Banner -->
  <view class="card banner banner-hero">
    <view class="banner-title">青年周刊</view>
    <view class="banner-subtitle">为年轻人打造的内容聚合周刊</view>
  </view>

  <!-- 最新一期 -->
  <view wx:if="{{latestIssue}}" class="card" bindtap="goToIssue" data-slug="{{latestIssue.slug}}">
    <view class="card-head">
      <text class="text-meta-sm">最新一期</text>
      <text class="link-more">查看全部 ></text>
    </view>
    <view class="text-title" style="margin-bottom: 12rpx;">
      {{latestIssue.title}}
    </view>
    <view class="text-meta" style="margin-bottom: 16rpx;">
      {{latestIssue.date}} · 第{{latestIssue.issue}}期
    </view>
    <view class="text-body">
      {{latestIssue.description}}
    </view>
  </view>

  <!-- 分类入口 -->
  <view class="card">
    <view class="card-title">内容分类</view>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-cell"
      >
        <view class="category-icon">{{item.icon}}</view>
        <view class="category-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 近期周刊 -->
  <view class="card" wx:if="{{recentIssues.length > 1}}">
    <view class="card-head-lg">
      <view class="card-title" style="margin: 0;">近期周刊</view>
      <text class="link-more" bindtap="goToAllIssues">全部 ></text>
    </view>
    <view
      wx:for="{{recentIssues}}"
      wx:key="slug"
      wx:if="{{index > 0}}"
      class="list-row"
      bindtap="goToIssue"
      data-slug="{{item.slug}}"
    >
      <view style="font-size: 30rpx; font-weight: 500; margin-bottom: 8rpx;">
        {{item.title}}
      </view>
      <view class="text-muted">
        {{item.date}} · 第{{item.issue}}期
      </view>
    </view>
  </view>

  <!-- 订阅提示 -->
  <view class="card banner banner-accent">
    <view class="text-title" style="color: #fff; margin-bottom: 12rpx;">
      订阅青年周刊
    </view>
    <view class="banner-subtitle" style="margin-bottom: 24rpx;">
      每周一更新，不错过任何精彩内容
    </view>
    <button class="button" style="background: white; color: #0ea5e9;" open-type="share">
      分享给朋友
    </button>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
