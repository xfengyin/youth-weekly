<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 内容不存在（非法 slug / 无此期次） -->
  <view wx:elif="{{notFound}}" class="empty">
    <text>该期周刊不存在或已被移除</text>
    <navigator url="/pages/list/list" open-type="switchTab" class="link-back" style="display: block; margin-top: 20rpx;">
      返回周刊列表
    </navigator>
  </view>

  <!-- 内容 -->
  <block wx:else>
    <!-- 头部信息 -->
    <view class="card banner banner-accent">
      <view class="banner-subtitle" style="margin-bottom: 16rpx;">
        {{issue.date}} · 第{{issue.issue}}期
      </view>
      <view style="font-size: 40rpx; font-weight: bold; line-height: 1.4;">
        {{issue.title}}
      </view>
    </view>

    <!-- 文章正文（rich-text 内容已在 JS 侧 HTML 转义） -->
    <view class="card">
      <rich-text nodes="{{content}}"></rich-text>
    </view>

    <!-- 分享按钮 -->
    <view class="card" style="text-align: center;">
      <button open-type="share" class="button button-primary" style="width: 100%;">
        分享给朋友
      </button>
    </view>

    <!-- 返回列表 -->
    <view class="bottom-tip">
      <navigator url="/pages/list/list" open-type="switchTab" class="link-back">
        ← 返回周刊列表
      </navigator>
    </view>
  </block>
</view>
