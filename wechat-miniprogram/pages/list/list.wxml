<view class="container">
  <!-- 标题 -->
  <view class="card">
    <view style="font-size: 36rpx; font-weight: bold;">所有周刊</view>
    <view class="text-meta" style="margin-top: 8rpx;">
      共 {{issues.length}} 期内容
    </view>
  </view>

  <!-- 周刊列表 -->
  <view
    wx:for="{{issues}}"
    wx:key="slug"
    class="card"
    bindtap="goToDetail"
    data-slug="{{item.slug}}"
  >
    <view class="card-head-start">
      <view class="text-muted">
        {{item.date}}
      </view>
      <view class="issue-badge">
        第{{item.issue}}期
      </view>
    </view>

    <view class="text-title" style="margin-bottom: 12rpx;">
      {{item.title}}
    </view>

    <view class="text-body">
      {{item.description}}
    </view>

    <view style="margin-top: 20rpx; text-align: right;">
      <text class="link-more" style="font-size: 26rpx;">阅读全文 →</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && issues.length === 0}}" class="empty">
    <image class="empty-icon" src="/images/empty.png" mode="aspectFit"/>
    <text>暂无周刊内容</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 底部提示 -->
  <view wx:if="{{!loading && issues.length > 0}}" class="bottom-tip">
    已经到底了
  </view>
</view>
