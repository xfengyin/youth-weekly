/**app.wxss**/
page {
  --primary: #0ea5e9;
  --primary-light: #e0f2fe;
  --text-primary: #1f2937;
  --text-secondary: #6b7280;
  --text-body: #4b5563;
  --text-muted: #9ca3af;
  --background: #f3f4f6;
  --white: #ffffff;
  --border: #e5e7eb;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--background);
  color: var(--text-primary);
  line-height: 1.6;
}

.container {
  padding: 20rpx;
}

/* ── 卡片 ── */
.card {
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
}

/* ── 按钮 ── */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: opacity 0.2s;
}

.button-primary {
  background: var(--primary);
  color: var(--white);
}

.button:active {
  opacity: 0.8;
}

/* ── 加载 / 空状态 ── */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  color: var(--text-secondary);
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-secondary);
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

/* ── 品牌横幅（首页头图 / 订阅与详情页头卡） ── */
.banner {
  color: var(--white);
}

.banner-hero {
  background: linear-gradient(135deg, #0ea5e9, #d946ef);
}

.banner-accent {
  background: linear-gradient(135deg, #0ea5e9, #8b5cf6);
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* ── 文本层级 ── */
.text-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
}

.text-body {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-body);
}

.text-meta {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.text-meta-sm {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.text-muted {
  font-size: 24rpx;
  color: var(--text-muted);
}

.link-more {
  font-size: 24rpx;
  color: var(--primary);
}

.link-back {
  color: var(--primary);
  font-size: 28rpx;
}

/* ── 布局小件 ── */
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-head-lg {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-head-start {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.list-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.issue-badge {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.bottom-tip {
  text-align: center;
  padding: 40rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* ── 分类网格 ── */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.category-cell {
  width: 33.33%;
  text-align: center;
  padding: 20rpx 0;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 26rpx;
  color: var(--text-body);
}
