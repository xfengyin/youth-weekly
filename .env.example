# =============================================================================
# 青年周刊 · 环境变量模板
# -----------------------------------------------------------------------------
# 用法：
#   - 本地开发：复制为 .env.local（已被 .gitignore 忽略）后按需填写
#   - CI/CD：在 GitHub Secrets 中配置同名变量，工作流中以 ${{ secrets.X }} 引用
# 注意：切勿把真实密钥写入本文件或任何被提交的文件。
# =============================================================================

# LLM 杂志化改写 API Key（config.yaml 的 llm.api_key 留空时从此变量读取）
# 支持 OpenAI / OpenAI 兼容端点（DeepSeek、Moonshot、Azure 等）/ Anthropic
YOUTH_WEEKLY_LLM_API_KEY=

# 项目根目录（覆盖配置路径推算；默认自动推算到仓库根目录）
YOUTH_WEEKLY_ROOT=

# Web 端 Markdown 文档目录（Next.js 静态生成读取；默认 <root>/docs）
DOCS_PATH=

# 配置文件路径（覆盖默认 config.yaml 的加载位置）
YOUTH_WEEKLY_CONFIG=
